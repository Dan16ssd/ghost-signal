# Copy to .env (never commit .env). All values are optional for local testing.

# Claude writes the answers (otherwise the first sentences of the source are used)
ANTHROPIC_API_KEY=
GHOST_USE_LLM=true
GHOST_MODEL=claude-opus-5-5
GHOST_MAX_SEGMENTS=3
GHOST_MAX_PER_HOUR=20
# All senders together: AI calls per day; above it answers use plain source extracts
GHOST_MAX_AI_PER_DAY=2000
GHOST_MAX_REMINDERS=5
# SQLite file for opt-outs, limits and reminders (mount a volume here in production)
GHOST_DB=ghost_signal.db

# Twilio (real SMS). Without them the /sms webhook replies inline with TwiML.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The public https URL Twilio calls, e.g. https://ghost-signal.example.com
PUBLIC_BASE_URL=

# Contact info for the User-Agent (Wikipedia requires it): your public repo URL or an email
GHOST_CONTACT=
