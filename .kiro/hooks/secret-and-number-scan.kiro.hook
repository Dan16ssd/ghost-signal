{
  "enabled": true,
  "name": "Secret and phone number scan",
  "description": "Before code is committed, make sure no API key, Twilio token or real phone number is in a tracked file.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py",
      "**/*.md",
      "**/*.html",
      "**/*.json",
      "**/*.yml",
      "**/*.yaml",
      "**/*.toml",
      ".env.example"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Check the saved file for secrets: Anthropic keys (sk-ant-), Twilio Account SIDs (AC followed by 32 hex characters), auth tokens, and real-looking phone numbers outside tests (tests may use +1555... and documented example numbers). Values belong only in .env, which is git-ignored. If you find one, name the file and line, replace it with an environment variable, and say so. Otherwise reply 'clean' in one line."
  }
}
